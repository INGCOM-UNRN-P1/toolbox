# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C / Object files
*.o
*.so
*.out
*.exe

# ...pero las salidas esperadas de los casos de prueba NO son binarios `a.out`:
# sin esta excepción, agregar un caso nuevo pierde su .out en silencio y la
# suite queda comparando contra nada.
!student-smoke-test/testcases/*.out
!student-smoke-test/testcases_fuzz/*.out

# Virtual environments
.venv/
venv/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Editors & OS
.DS_Store
.vscode/
.idea/
*.swp
*~

build/
.frama-c/
